# Configuração do Git Fácil
# Copie este arquivo para "config.env" (o app também cria sozinho no primeiro acesso).

# Pasta onde os projetos serão baixados (padrão: Documentos\Projetos)
# PASTA_PROJETOS="C:\Users\fulano\Documents\Projetos"

# Preenchidos pela tela no primeiro acesso
NOME=""
EMAIL=""

# --- Acesso ao repositório (opcional) ---
# Sem token: o Git for Windows abre uma janela de login do GitHub/GitLab
# na primeira vez e guarda o acesso no Windows. É o caminho mais simples.
#
# Com token: preencha abaixo. O token nunca é gravado dentro dos projetos.
#   GitHub  -> TOKEN_USUARIO="x-access-token"
#   GitLab  -> TOKEN_USUARIO="oauth2"
# TOKEN_USUARIO="x-access-token"
# TOKEN=""
